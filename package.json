{
  "name": "btc-lightning-pay",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @btc-lightning-pay/frontend --filter @btc-lightning-pay/backend run dev",
    "dev:gateway": "pnpm --filter @btc-lightning-pay/gateway dev",
    "dev:frontend": "pnpm --filter @btc-lightning-pay/frontend dev",
    "dev:backend": "pnpm --filter @btc-lightning-pay/backend dev",
    "build": "pnpm -r run build",
    "typegen": "pnpm --filter './apps/*' run typegen",
    "typecheck": "pnpm typegen && pnpm -r run typecheck && tsc --noEmit",
    "check": "vp check",
    "format": "vp fmt",
    "test": "vp test run",
    "ready": "pnpm typecheck && pnpm check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.21.0"
}
