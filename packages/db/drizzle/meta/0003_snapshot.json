      "policies": {
        "order_access": {
          "name": "order_access",
          "as": "PERMISSIVE",
          "for": "ALL",
          "to": ["public"],
          "using": "current_setting('app.payment_admin', true) = 'true' OR \"payment_order\".\"merchant_id\" = nullif(current_setting('app.merchant_id', true), '') OR \"payment_order\".\"id\"::text = nullif(current_setting('app.order_id', true), '')",
          "withCheck": "current_setting('app.payment_admin', true) = 'true' OR \"payment_order\".\"merchant_id\" = nullif(current_setting('app.merchant_id', true), '')"
        }
      },
      "checkConstraints": {
        "order_usd": {
          "name": "order_usd",
          "value": "\"payment_order\".\"amount_usd_cents\" BETWEEN 1000 AND 30000"
        },
        "order_sats": {
          "name": "order_sats",
          "value": "\"payment_order\".\"amount_sat\" BETWEEN 1 AND 2100000000000000"
        },
        "order_reference": {
          "name": "order_reference",
          "value": "length(\"payment_order\".\"reference\") <= 128"
        },
        "order_rate": {
          "name": "order_rate",
          "value": "\"payment_order\".\"rate_usd\" ~ '^[0-9]+([.][0-9]+)?$' AND \"payment_order\".\"rate_usd\"::numeric > 0"
        },
        "order_status": {
          "name": "order_status",
          "value": "\"payment_order\".\"status\" IN ('creating','pending','paid','expired','failed')"
        },
        "order_invoice_consistency": {
          "name": "order_invoice_consistency",
          "value": "(\"payment_order\".\"invoice\" IS NULL AND \"payment_order\".\"payment_hash\" IS NULL AND \"payment_order\".\"expires_at\" IS NULL) OR (\"payment_order\".\"invoice\" IS NOT NULL AND \"payment_order\".\"payment_hash\" ~ '^[0-9a-f]{64}$' AND \"payment_order\".\"expires_at\" IS NOT NULL)"
        },
        "order_paid_consistency": {
          "name": "order_paid_consistency",
          "value": "(\"payment_order\".\"status\" = 'paid' AND \"payment_order\".\"paid_at\" IS NOT NULL AND \"payment_order\".\"payment_hash\" IS NOT NULL AND \"payment_order\".\"received_msat\" >= 0 AND \"payment_order\".\"fee_msat\" >= 0 AND \"payment_order\".\"received_msat\" + \"payment_order\".\"fee_msat\" = \"payment_order\".\"amount_sat\" * 1000) OR (\"payment_order\".\"status\" <> 'paid' AND \"payment_order\".\"paid_at\" IS NULL AND \"payment_order\".\"received_msat\" IS NULL AND \"payment_order\".\"fee_msat\" IS NULL)"
        },
        "order_settled_paid": {
          "name": "order_settled_paid",
          "value": "\"payment_order\".\"settlement_id\" IS NULL OR \"payment_order\".\"status\" = 'paid'"
        }
      },
