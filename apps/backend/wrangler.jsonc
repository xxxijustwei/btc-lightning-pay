{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "btc-lightning-pay-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "APP_ENV": "production" },
  // Reached only through the frontends' service bindings: no public workers.dev or preview URL.
  "workers_dev": false,
  "preview_urls": false,
  // Every minute: credit wallet receipts, release abandoned reservations, and every fifth minute
  // store the Coinbase BTC/USD quote that order creation reads (payments/jobs.ts).
  "triggers": { "crons": ["* * * * *"] },
  // Edge limits on the payer API (payments/handler.ts). Namespace ids are account-local numbers.
  "ratelimits": [
    {
      "name": "ORDER_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  // Run request handlers next to the business database: one order makes about a dozen sequential
  // queries, so each must be a short round trip. Keep this equal to DATABASE_URL's Supabase region.
  // Placement applies to fetch handlers only; the cron makes a single write and is unaffected.
  "placement": { "region": "aws:us-east-1" },
  // Pooled connections remove the per-request connect cost (see docs/backend-setup.md).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "d665b0bd9f574d9195f06cce5deacb56" }],
}
